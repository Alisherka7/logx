{
  "name": "logx-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local logging toolkit for AI coding agents: deterministic backend logging checks, agent skills, and project logging conventions.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "logx": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    "templates/",
    "python/logx_analyzer/*.py"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:python": "node scripts/test-python.mjs",
    "test:all": "npm run test:python && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "npm run build && node scripts/smoke-pack.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run test:all && node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
